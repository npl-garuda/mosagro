        <mxCell id="p4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#BBBBBB;fontSize=10;align=left;spacingLeft=8;" value="МосАгро | Главная | О компании | Каталог | Эксклюзив | Документы | Прайс | Контакты" vertex="1">
