          <mxGeometry height="36" width="150" x="260" y="660" as="geometry" />
        </mxCell>
        <mxCell id="t10" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EFEFEF;strokeColor=#CCCCCC;align=left;spacingLeft=8;fontSize=10;" value="Меню ·&amp;nbsp; sales@mos-agro.ru · Реквизиты · Политика ПДн · Согласие" vertex="1">
          <mxGeometry height="50" width="690" x="55" y="715" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="rounded=4;whiteSpace=wrap;html=1;fillColor=#FFF3CD;strokeColor=#E0A800;align=left;verticalAlign=top;spacingLeft=6;spacingTop=4;fontSize=10;fontColor=#664D03;" value="Для дизайнера:&lt;br&gt;Тон как на главной:&lt;br&gt;сад/ферма + опт/SEO.&lt;br&gt;См. docs/copy.md" vertex="1">
